# Gin Rummy — environment variables (names only; secrets live in Railway
# service variables / your local .env, never in the repo).
#
# ZERO of these are required for local dev: `PROVIDERS=fixture` (the default)
# runs the whole app with deterministic fixture data.

# --- Core ---------------------------------------------------------------
NODE_ENV=
# fixture | live (default: fixture)
PROVIDERS=
APP_URL=
LOG_LEVEL=

# --- Infrastructure (Railway managed services) --------------------------
DATABASE_URL=
REDIS_URL=

# --- Auth.js ------------------------------------------------------------
# `npx auth secret` to generate. Required in production.
AUTH_SECRET=
# Google OAuth client (spec §2.1) — doubles as the YouTube connect flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored YouTube refresh tokens (AES-256-GCM). Falls back to
# AUTH_SECRET when unset — set it so token re-encryption isn't coupled to
# session-secret rotation.
CHANNEL_TOKEN_SECRET=

# --- Provider APIs (required when PROVIDERS=live) -----------------------
# YouTube Data API v3 public reads (spec §2.1)
GOOGLE_API_KEY=
# Anthropic (spec §2.2) — models pinned in lib/config.ts
ANTHROPIC_API_KEY=
# LLM backend: anthropic (default) or grok — the tier models are translated per backend
LLM_BACKEND=
XAI_API_KEY=
# Override Grok tier models if xAI renames them (verify at console.x.ai)
XAI_MODEL_MAIN=
XAI_MODEL_FAST=
# Licensed transcript provider (spec §2.3)
TRANSCRIPT_API_KEY=
# Brave/Exa web search (spec §2.4)
SEARCH_API_KEY=
# Thumbnail image generation (spec §2.5)
IMAGE_API_KEY=
# Embeddings for idea dedup (spec §5.4)
VOYAGE_API_KEY=

# --- Payments (spec §2.6) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) or price lookup keys — one per paid tier, plus the
# metered $0.60/credit overage price (Billing Meter "overage_credits").
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_OVERAGE=

# --- Email (spec §2.7) ---------------------------------------------------
# Without RESEND_API_KEY, magic links are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=

# --- Monitoring / analytics (spec §2.7) ----------------------------------
SENTRY_DSN=
POSTHOG_KEY=

# --- Object storage (Railway Storage Bucket, S3 API) ---------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Feature flags (wave C, PRODUCT-CONTRACTS §3) ------------------------
# partnered_named generation mode. Default false; the server rejects
# partnered_named requests while off. Only ever enable on deployments with
# signed partner licenses on file.
FEATURE_PARTNERED_NAMED=
